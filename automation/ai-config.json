{
  "_comment": "Project Aussie AI development config. Model names and prices are defaults checked against the providers' public docs on 2026-11-09; re-check them before enabling. Repo variables (AI_*_MODEL, AI_DAILY_BUDGET_USD, ...) override these at run time.",
  "owner": "ajstuart2000-cyber",
  "timezone": "Australia/Perth",
  "utc_offset_hours": 8,
  "report_issue_title": "Daily AI development reports",
  "labels": {
    "approved": "ai-approved",
    "audio_approved": "audio-approved",
    "protected_change_approved": "protected-change-approved",
    "revise": "ai-revise",
    "generated": "ai-generated",
    "report": "ai-report",
    "blocked": ["ai-blocked", "ai-done", "wontfix", "duplicate", "invalid"],
    "audio_topic": ["audio", "sound"],
    "priority_prefix": "priority:",
    "merge_block": ["ai-revise", "ai-blocked", "do-not-merge", "wontfix"]
  },
  "roles": {
    "grok": {
      "label": "ai:grok",
      "provider": "xai",
      "title": "Gameplay developer",
      "areas": ["New features", "Burnout improvements", "Drag and roll racing", "Free-roam improvements"],
      "secret": "XAI_API_KEY",
      "model_var": "AI_GROK_MODEL",
      "default_model": "grok-4.7",
      "may_touch_audio": false,
      "allowed_paths": ["www/index.html", "docs/**"]
    },
    "claude": {
      "label": "ai:claude",
      "provider": "anthropic",
      "title": "Technical developer",
      "areas": ["Driving physics", "Memory management", "Graphics optimisation", "Android performance", "Sound / audio (only on issues the owner labels audio-approved)"],
      "secret": "ANTHROPIC_API_KEY",
      "model_var": "AI_CLAUDE_MODEL",
      "default_model": "claude-sonnet-5-5",
      "may_touch_audio": true,
      "allowed_paths": ["www/index.html", "android/app/src/main/java/**", "android/app/src/main/AndroidManifest.xml", "android/app/src/main/res/values/**", "docs/**"],
      "audio_extra_paths": ["www/assets/*_voice.json"]
    },
    "chatgpt": {
      "provider": "openai",
      "title": "Code reviewer",
      "areas": ["Review pull requests", "Detect integration problems", "Check Android compatibility", "Recommend fixes"],
      "secret": "OPENAI_API_KEY",
      "model_var": "AI_CHATGPT_MODEL",
      "default_model": "gpt-6.1-sol",
      "reviewer": true
    }
  },
  "providers": {
    "xai": {"name": "xAI (Grok)", "url": "https://api.x.ai/v1/responses", "model_prefixes": ["grok"]},
    "anthropic": {"name": "Anthropic (Claude)", "url": "https://api.anthropic.com/v1/messages", "model_prefixes": ["claude"]},
    "openai": {"name": "OpenAI (ChatGPT)", "url": "https://api.openai.com/v1/chat/completions", "model_prefixes": ["gpt", "o"]}
  },
  "pricing_usd_per_mtok": {
    "_comment": "Used only to ESTIMATE spend from the usage numbers each API returns. Unknown models use the provider fallback, which is deliberately high. Check current prices.",
    "grok-4.7": {"in": 2.0, "out": 6.0},
    "claude-sonnet-5-5": {"in": 2.0, "out": 10.0},
    "claude-opus-5-5": {"in": 4.0, "out": 20.0},
    "fallback:xai": {"in": 4.0, "out": 12.0},
    "fallback:anthropic": {"in": 10.0, "out": 50.0},
    "fallback:openai": {"in": 10.0, "out": 40.0}
  },
  "limits": {
    "daily_budget_usd": 2.0,
    "max_calls_per_run": 2,
    "max_output_tokens": 16000,
    "max_input_chars": 160000,
    "max_review_diff_chars": 60000,
    "max_changed_lines": 400,
    "request_timeout_s": 600
  },
  "auto_merge": {
    "_comment": "Auto-merge of AI pull requests was enabled at the owner's request (ajstuart2000-cyber) on 2026-11-10. It only acts when the repository variable AI_AUTO_MERGE is exactly \"true\". Set AI_AUTO_MERGE to false (or delete it) to turn it off; AI PRs then wait for the owner again. Every gate below is enforced in automation/aidev/mergegate.py.",
    "enabled_var": "AI_AUTO_MERGE",
    "enabled_by_owner_on": "2026-11-10",
    "base": "main",
    "merge_method": "squash",
    "required_label": "ai-generated",
    "branch_prefix": "ai/",
    "allowed_authors": ["github-actions[bot]"],
    "commit_author_prefix": "project-aussie-ai-",
    "commit_email": "41898282+github-actions[bot]@users.noreply.github.com",
    "required_checks": ["validation", "android", "guardrails"],
    "reviewer_endpoint_host": "api.openai.com",
    "max_pr_commits": 20
  },
  "protect": {
    "package_id": "com.barrarun.game",
    "signing_files": ["*.keystore", "*.jks", "keystore.properties", "*.p12"],
    "gradle_protected_line": "\\b(applicationId|applicationIdSuffix|namespace|signingConfigs?|storeFile|storePassword|keyAlias|keyPassword)\\b",
    "manifest_protected_line": "\\b(package|android:sharedUserId)\\s*=",
    "ai_forbidden_paths": [".github/**", "automation/**", "android/*.gradle", "android/app/*.gradle", "android/gradle/**", "android/gradlew*", "android/gradle.properties", "www/vendor/**", "www/assets/**"],
    "protected_asset_paths": ["www/assets/**", "www/vendor/**"],
    "audio_paths": ["**/*.wav", "**/*.mp3", "**/*.ogg", "**/*.m4a", "www/assets/*_voice.json", "www/assets/barra.json", "www/assets/cammed.json", "www/assets/ecotec.json", "www/assets/ls3.json", "www/assets/v8.json"],
    "audio_section_marker": "/* ================= audio ================= */",
    "audio_functions": ["getPack", "setEngineSound", "setEngineSound0", "sirenOn", "thud", "loadSoundData", "ensurePack", "startAudio", "updateAudio"],
    "audio_line_regex": "AudioContext|webkitAudioContext|decodeAudioData|createGain|createOscillator|createBufferSource|createBiquadFilter|\\.wav\\b|\\bsfx\\b|\\bAC\\b|\\bmaster\\b|volume|getPack|setEngineSound|sirenOn|loadSoundData|\\bthud\\(",
    "save_key_regex": "['\"`](barra\\.[A-Za-z0-9_]+\\.?)",
    "vehicles": {
      "falcon": {"base": "assets/falcon.model.json", "swap": "assets/swap.json", "partsDir": "assets/parts/"},
      "au": {"base": "assets/au/au_base.json", "swap": "assets/au/swap.json", "partsDir": "assets/au/parts/"},
      "auute": {"base": "assets/au/auute_base.json", "swap": "assets/au/ute_swap.json", "partsDir": "assets/au/parts/"}
    }
  }
}
